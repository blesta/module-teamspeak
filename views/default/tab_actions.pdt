<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('Teamspeak.tab_actions.status_title'); ?></h6>
<div class="mb-3">
    <?php if ($server_info->state == 'online') {
        $status_class = 'success';
        $status = 'online';
    } elseif ($server_info->state == 'offline') {
        $status_class = 'danger';
        $status = 'offline';
    } ?>

    <span class="btn btn-sm btn-<?php echo isset($status_class)
        ? $this->Html->safe($status_class)
        : null; ?>" style="padding: 2px 4px;" disabled="disabled">
        <i class="bi bi-lightbulb"></i> <?php $this->_(
            'Teamspeak.tab_actions.status_' . (isset($status) ? $this->Html->safe($status) : null),
        ); ?>
    </span>
</div>

<h6 class="form-section-header"><?php $this->_('Teamspeak.tab_actions.server_title'); ?></h6>
<div class="mb-3">
    <div class="row options">
        <div class="col-md-4">
            <?php
            $this->Form->create();
            $this->Form->fieldHidden('action', 'restart');
            ?>
            <button<?php echo ($status ?? null) != 'online'
                ? ' disabled="disabled"'
                : ''; ?> class="btn btn-success w-100">
                <i class="bi bi-arrow-clockwise"></i> <?php $this->_('Teamspeak.tab_actions.action_restart'); ?>
                </button>
            <?php $this->Form->end(); ?>

            <?php
            $this->Form->create();
            $this->Form->fieldHidden('action', 'change_name');
            ?>
                <button class="name btn btn-outline-secondary w-100 mt-2">
                    <i class="bi bi-pencil"></i> <?php $this->_('Teamspeak.tab_actions.action_edit_name'); ?>
                </button>
            <?php $this->Form->end(); ?>
        </div>
        <div class="col-md-4">
            <?php
            $this->Form->create();
            $this->Form->fieldHidden('action', 'stop');
            ?>
            <button<?php echo ($status ?? null) != 'online'
                ? ' disabled="disabled"'
                : ''; ?> class="btn btn-danger w-100">
                <i class="bi bi-stop-fill"></i> <?php $this->_('Teamspeak.tab_actions.action_stop'); ?>
                </button>
            <?php $this->Form->end(); ?>

            <?php
            $this->Form->create();
            $this->Form->fieldHidden('action', 'remove_ban');
            ?>
                <button class="btn btn-outline-secondary w-100 mt-2">
                    <i class="bi bi-slash-circle"></i> <?php $this->_('Teamspeak.tab_actions.action_remove_ban'); ?>
                </button>
            <?php $this->Form->end(); ?>
        </div>
        <div class="col-md-4">
            <?php
            $this->Form->create();
            $this->Form->fieldHidden('action', 'start');
            ?>
            <button<?php echo ($status ?? null) != 'offline'
                ? ' disabled="disabled"'
                : ''; ?> class="btn btn-outline-secondary w-100">
                <i class="bi bi-play-fill"></i> <?php $this->_('Teamspeak.tab_actions.action_start'); ?>
                </button>
            <?php $this->Form->end(); ?>

            <?php
            $this->Form->create();
            $this->Form->fieldHidden('action', 'reset_permissions');
            ?>
                <button class="btn btn-outline-secondary w-100 mt-2">
                    <i class="bi bi-arrow-clockwise"></i> <?php $this->_(
                        'Teamspeak.tab_actions.action_reset_permissions',
                    ); ?>
                </button>
            <?php $this->Form->end(); ?>
        </div>
    </div>
</div>

<div id="change_name" style="display:none;">
    <h6 class="form-section-header"><?php $this->_('Teamspeak.tab_actions.heading_change_name'); ?></h6>
    <?php
$this->Form->create();
?>
    <div>
        <div class="mb-3">
            <?php
            $this->Form->label($this->_('Teamspeak.tab_actions.field_name', true), 'name', ['class' => 'form-label']);
            $this->Form->fieldText('name', $vars->name ?? null, [
                'id' => 'name',
                'class' => 'form-control',
                'placeholder' => $this->_('Teamspeak.tab_actions.field_name', true),
            ]);
            $this->Form->fieldHidden('action', 'change_name');
            ?>
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <?php $this->Form->fieldSubmit('save', $this->_('Teamspeak.tab_actions.field_name_submit', true), [
            'class' => 'btn btn-primary',
        ]); ?>
    </div>
    <?php $this->Form->end(); ?>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelector('.options button.name').addEventListener('click', function() {
            var el = document.getElementById('change_name');
            el.style.display = el.style.display === 'none' ? '' : 'none';
        });
    });
</script>
