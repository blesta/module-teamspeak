<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('Teamspeak.tab_clients.heading_clients'); ?></h6>
<div class="mb-3">
    <table class="table">
        <thead>
            <tr>
                <th><span><?php $this->_('Teamspeak.tab_clients.clients_heading.client_id'); ?></span></th>
                <th><span><?php $this->_('Teamspeak.tab_clients.clients_heading.client_name'); ?></span></th>
                <th><span><?php $this->_('Teamspeak.tab_clients.clients_heading.options'); ?></span></th>
            </tr>
        </thead>
        <tbody>

            <?php if (!empty($server_clients->clients)) {
                $i = 0;
                foreach ($server_clients->clients as $client) { ?>
            <tr>
                <td><?php echo isset($client->clid) ? $this->Html->safe($client->clid) : null; ?></td>
                <td><?php echo isset($client->name) ? $this->Html->safe($client->name) : null; ?></td>
                <td>
                    <?php
                    $this->Form->create();
                    $this->Form->fieldHidden('action', 'kick_client');
                    $this->Form->fieldHidden('clid', $client->clid);
                    ?>
                    <button type="submit" class="btn btn-sm btn-outline-danger"
                        title="<?php $this->_('Teamspeak.tab_clients.action_kick_client'); ?>">
                        <i class="bi bi-person-x"></i>
                    </button>
                    <?php $this->Form->end(); ?>
                </td>
            </tr>
                    <?php $i++;
                }
            } else {
                ?>
            <tr>
                <td colspan="3"><?php $this->_('Teamspeak.tab_clients.text_no_clients'); ?></td>
            </tr>
                    <?php
            } ?>
        </tbody>
    </table>
</div>
