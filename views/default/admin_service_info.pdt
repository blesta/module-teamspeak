<?php /** @var View $this **/ ?>

<table class="table">
    <thead>
        <tr>
            <th><i class="bi bi-arrow-up"></i></th>
            <th><?php $this->_('Teamspeak.service_info.hostname'); ?></th>
            <th><?php $this->_('Teamspeak.service_info.port'); ?></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td></td>
            <td><?php echo isset($module_row->meta->hostname)
                ? $this->Html->safe($module_row->meta->hostname)
                : null; ?></td>
            <td><?php echo isset($service_fields->teamspeak_port)
                ? $this->Html->safe($service_fields->teamspeak_port)
                : null; ?></td>
        </tr>
    </tbody>
</table>
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('teamspeak_login<?php echo isset($service->id)
            ? $this->Html->safe($service->id)
            : null; ?>').addEventListener('click', function(e) {
            e.preventDefault();

            this.closest('form').submit();
        });
    });
</script>
