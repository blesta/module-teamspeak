<?php /** @var View $this **/ ?>

<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => $this->_('Teamspeak.back_to_manage', true),
        'icon' => 'bi bi-arrow-left me-1',
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/manage/' . $module->id],
    ],
]);
$this->Form->create(null, ['class' => 'disable-on-submit']);
$this->Widget->create($this->_('Teamspeak.edit_row.box_title', true));

$this->Form->fieldHidden('account_count', $vars->account_count ?? 0);
?>

<h6 class="form-section-header"><?php $this->_('Teamspeak.edit_row.basic_title'); ?></h6>

<div class="mb-3">
    <label for="server_name" class="form-label">
        <?php $this->_('Teamspeak.row_meta.server_name'); ?>
    </label>
    <?php $this->Form->fieldText('server_name', $vars->server_name ?? null, [
        'id' => 'server_name',
        'class' => 'form-control',
    ]); ?>
</div>

<div class="mb-3">
    <label for="hostname" class="form-label">
        <?php $this->_('Teamspeak.row_meta.hostname'); ?>
    </label>
    <?php $this->Form->fieldText('hostname', $vars->hostname ?? null, [
        'id' => 'hostname',
        'class' => 'form-control',
    ]); ?>
</div>

<div class="mb-3">
    <label for="port" class="form-label">
        <?php $this->_('Teamspeak.row_meta.port'); ?>
    </label>
    <?php $this->Form->fieldText('port', $vars->port ?? 10011, ['id' => 'port', 'class' => 'form-control']); ?>
</div>

<div class="mb-3">
    <label for="username" class="form-label">
        <?php $this->_('Teamspeak.row_meta.username'); ?>
    </label>
    <?php $this->Form->fieldText('username', $vars->username ?? null, [
        'id' => 'username',
        'class' => 'form-control',
    ]); ?>
</div>

<div class="mb-3">
    <label for="password" class="form-label">
        <?php $this->_('Teamspeak.row_meta.password'); ?>
    </label>
    <?php $this->Form->fieldPassword('password', [
        'id' => 'password',
        'class' => 'form-control',
        'value' => $vars->password ?? null,
    ]); ?>
</div>

<div class="mb-3">
    <label for="account_limit" class="form-label">
        <?php $this->_('Teamspeak.row_meta.account_limit'); ?>
    </label>
    <?php $this->Form->fieldText('account_limit', $vars->account_limit ?? null, [
        'id' => 'account_limit',
        'class' => 'form-control',
    ]); ?>
</div>

<h6 class="form-section-header mt-4"><?php $this->_('Teamspeak.edit_row.notes_title'); ?></h6>
<div class="mb-3">
    <?php $this->Form->fieldTextarea('notes', $vars->notes ?? null, ['id' => 'notes', 'class' => 'form-control']); ?>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('Teamspeak.edit_row.add_btn', true), [
        'class' => 'btn btn-primary',
    ]); ?>
</div>

<?php
$this->Widget->end();
$this->Form->end();


