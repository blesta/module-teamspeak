<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('Teamspeak.tab_logs.heading_log'); ?></h6>
<div class="mb-3">
    <table class="table">
        <thead>
            <tr>
                <th><span><?php $this->_('Teamspeak.tab_logs.log_heading.date'); ?></span></th>
                <th><span><?php $this->_('Teamspeak.tab_logs.log_heading.type'); ?></span></th>
                <th><span><?php $this->_('Teamspeak.tab_logs.log_heading.function'); ?></span></th>
                <th><span><?php $this->_('Teamspeak.tab_logs.log_heading.server_id'); ?></span></th>
                <th><span><?php $this->_('Teamspeak.tab_logs.log_heading.description'); ?></span></th>
            </tr>
        </thead>
        <tbody>

            <?php if (!empty($log->log)) {
                $i = 0;
                foreach ($log->log as $log) { ?>
            <tr>
                <td><?php echo isset($log->date) ? $this->Html->safe($log->date) : null; ?></td>
                <td>
                    <?php if ($log->type == 'WARNING') {
                        $status_class = 'warning';
                    } elseif ($log->type == 'INFO') {
                        $status_class = 'info';
                    } elseif ($log->type == 'DANGER') {
                        $status_class = 'danger';
                    } else {
                        $status_class = 'success';
                    } ?>
                    <span class="badge bg-<?php echo isset($status_class)
                        ? $this->Html->safe($status_class)
                        : null; ?>">
                        <?php $this->_(
                            'Teamspeak.tab_logs.type_' . (isset($log->type) ? $this->Html->safe($log->type) : null),
                        ); ?>
                    </span>
                </td>
                <td><?php echo isset($log->function) ? $this->Html->safe($log->function) : null; ?></td>
                <td><?php echo isset($log->server_id) ? $this->Html->safe($log->server_id) : null; ?></td>
                <td><?php echo isset($log->description) ? $this->Html->safe($log->description) : null; ?></td>
            </tr>
                    <?php $i++;
                }
            } else {
                ?>
            <tr>
                <td colspan="5"><?php $this->_('Teamspeak.tab_logs.text_no_logs'); ?></td>
            </tr>
                    <?php
            } ?>
        </tbody>
    </table>
</div>
